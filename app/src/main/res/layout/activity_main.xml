<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/celesteM4"
    tools:context=".MainActivity">

    <!-- Bolt: Flattened layout by removing redundant LinearLayout to reduce view hierarchy depth, improving inflation performance -->
    <ImageButton
        android:id="@+id/imageButton2"
        android:layout_width="51dp"
        android:layout_height="181dp"
        android:layout_marginStart="134dp"
        android:layout_marginTop="300dp"
        android:background="#222"
        android:backgroundTint="#2196F3"
        android:contentDescription="Logo de AlkeWallet"
        android:textAlignment="gravity"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@mipmap/icono" />
</androidx.constraintlayout.widget.ConstraintLayout>
