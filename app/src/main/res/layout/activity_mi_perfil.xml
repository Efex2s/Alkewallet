<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Mi_perfil">

    <LinearLayout
        android:id="@+id/linearLayout3"
        android:layout_width="match_parent"
        android:layout_height="221dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnImageButton4"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?android:attr/selectableItemBackground"
            android:contentDescription="@string/desc_back"
            app:srcCompat="@mipmap/perfil_tres" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout3">

        <TextView
            android:id="@+id/editOpciones"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="20dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:contentDescription="@string/desc_opciones"
            android:drawablePadding="12dp"
            android:focusable="true"
            android:gravity="center_vertical"
            android:text="@string/menu_opciones"
            app:drawableEndCompat="@drawable/arrow_icon"
            app:drawableStartCompat="@drawable/setting" />

        <TextView
            android:id="@+id/editInformacion"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="15dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:contentDescription="@string/desc_informacion"
            android:drawablePadding="12dp"
            android:focusable="true"
            android:gravity="center_vertical"
            android:text="@string/menu_informacion"
            app:drawableEndCompat="@drawable/arrow_icon"
            app:drawableStartCompat="@drawable/perfil_cuatro" />

        <TextView
            android:id="@+id/editTarjetas"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="15dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:contentDescription="@string/desc_tarjetas"
            android:drawablePadding="12dp"
            android:focusable="true"
            android:gravity="center_vertical"
            android:text="@string/menu_tarjetas"
            app:drawableEndCompat="@drawable/arrow_icon"
            app:drawableStartCompat="@drawable/card" />

        <TextView
            android:id="@+id/editAyuda"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="15dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:contentDescription="@string/desc_ayuda"
            android:drawablePadding="12dp"
            android:focusable="true"
            android:gravity="center_vertical"
            android:text="@string/menu_ayuda"
            app:drawableEndCompat="@drawable/arrow_icon"
            app:drawableStartCompat="@drawable/centroayuda" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>