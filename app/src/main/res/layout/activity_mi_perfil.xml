<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Mi_perfil">

    <LinearLayout
        android:id="@+id/linearLayout3"
        android:layout_width="match_parent"
        android:layout_height="221dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnImageButton4"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/cd_back_button"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:srcCompat="@mipmap/perfil_tres" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout3">

        <TextView
            android:id="@+id/editOpciones"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:drawablePadding="12dp"
            android:textColor="@color/black"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground"
            android:drawableStart="@drawable/setting"
            android:drawableEnd="@drawable/arrow_icon"
            android:text="@string/profile_options" />

        <TextView
            android:id="@+id/editInformacion"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="15dp"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:drawablePadding="12dp"
            android:textColor="@color/black"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground"
            android:drawableStart="@drawable/perfil_cuatro"
            android:drawableEnd="@drawable/arrow_icon"
            android:text="@string/profile_info" />

        <TextView
            android:id="@+id/editTarjetas"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="15dp"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:drawablePadding="12dp"
            android:textColor="@color/black"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground"
            android:drawableStart="@drawable/card"
            android:drawableEnd="@drawable/arrow_icon"
            android:text="@string/profile_cards" />

        <TextView
            android:id="@+id/editAyuda"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="15dp"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:drawablePadding="12dp"
            android:textColor="@color/black"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground"
            android:drawableStart="@drawable/centroayuda"
            android:drawableEnd="@drawable/arrow_icon"
            android:text="@string/profile_help" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>